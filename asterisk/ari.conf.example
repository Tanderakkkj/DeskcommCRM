; asterisk/ari.conf.example
; Referência avançada. O caminho normal é executar
; bash hostgator-setup-kit/configurar-telefonia.sh: ele gera ari.conf privado
; com o mesmo usuário e senha ARI guardados no .env.

[general]
enabled = yes
pretty = yes

; Credenciais consumidas por ARI_USERNAME / ARI_PASSWORD no worker.
; Trocar por algo forte — não deixar o default em produção.
[voice-agent-user]
type = user
read_only = no
password = TROCAR_SENHA_FORTE
